  log("igual estricto");
}

if (a !== b) {
  log("diferente estricto");
}

if (a == b) {
  log("igual");
}

if (a != b) {
  log("diferente");
}

if (a <= b) {
  log("menor o igual");
}

if (a >= b) {
  log("mayor o igual");
}

if (a < b) {
  log("menor");
}

if (a > b) {
  log("mayor");
}

if (a > 0 && b > 0) {
  log("ambos positivos");
}

if (a > 0 || b > 0) {
  log("alguno positivo");
}

if (!a) {
  log("falsy");
}

